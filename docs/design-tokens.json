{
  "$description": "E-Dukan design tokens (W3C design-tokens format). Source of truth: src/index.css. Human guide: DESIGN.md.",
  "color": {
    "semantic": {
      "$description": "CSS variables --ds-* that switch under .dark. Tailwind: bg-<name>, text-<name>, border-<name>.",
      "canvas": {
        "$type": "color",
        "$value": "#F7FAF7",
        "$extensions": {
          "dark": "#161618",
          "tailwind": "bg-canvas",
          "usage": "App background"
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$extensions": {
          "dark": "#1E1E20",
          "tailwind": "bg-surface",
          "usage": "Cards, tables, form sections"
        }
      },
      "surface-raised": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$extensions": {
          "dark": "#2A2A2D",
          "tailwind": "bg-surface-raised",
          "usage": "Dialogs, popovers"
        }
      },
      "separator": {
        "$type": "color",
        "$value": "rgba(0, 0, 0, 0.08)",
        "$extensions": {
          "dark": "rgba(255, 255, 255, 0.09)",
          "tailwind": "border-separator",
          "usage": "Borders, dividers"
        }
      },
      "label": {
        "$type": "color",
        "$value": "#1F2937",
        "$extensions": {
          "dark": "#F5F5F7",
          "tailwind": "text-label",
          "usage": "Primary text"
        }
      },
      "label-secondary": {
        "$type": "color",
        "$value": "#6E6E73",
        "$extensions": {
          "dark": "#A1A1A6",
          "tailwind": "text-label-secondary",
          "usage": "Descriptions, metadata"
        }
      },
      "label-tertiary": {
        "$type": "color",
        "$value": "#8E8E93",
        "$extensions": {
          "dark": "#7C7C80",
          "tailwind": "text-label-tertiary",
          "usage": "Placeholders, disabled"
        }
      },
      "fill": {
        "$type": "color",
        "$value": "rgba(120, 120, 128, 0.12)",
        "$extensions": {
          "dark": "rgba(120, 120, 128, 0.24)",
          "tailwind": "bg-fill",
          "usage": "Hover and control fills"
        }
      },
      "fill-strong": {
        "$type": "color",
        "$value": "rgba(120, 120, 128, 0.2)",
        "$extensions": {
          "dark": "rgba(120, 120, 128, 0.36)",
          "tailwind": "bg-fill-strong",
          "usage": "Pressed fills"
        }
      },
      "accent": {
        "$type": "color",
        "$value": "#14532D",
        "$extensions": {
          "dark": "#22A06B",
          "tailwind": "bg-accent / text-accent",
          "usage": "Primary action, links, selection"
        }
      },
      "accent-soft": {
        "$type": "color",
        "$value": "#E8F5E9",
        "$extensions": {
          "dark": "rgba(34, 160, 107, 0.18)",
          "tailwind": "bg-accent-soft",
          "usage": "Active nav item, selected row"
        }
      },
      "success": {
        "$type": "color",
        "$value": "#248A3D",
        "$extensions": {
          "dark": "#30D158",
          "tailwind": "text-success"
        }
      },
      "warning": {
        "$type": "color",
        "$value": "#C93400",
        "$extensions": {
          "dark": "#FF9F0A",
          "tailwind": "text-warning"
        }
      },
      "danger": {
        "$type": "color",
        "$value": "#D70015",
        "$extensions": {
          "dark": "#FF453A",
          "tailwind": "text-danger"
        }
      }
    },
    "brand": {
      "$description": "\"Modern Green\" brand scale. Tailwind: brand-*. 500 = Primary (light accent), 400 = Secondary (dark accent, charts), 50 = Accent tint.",
      "50": {
        "$type": "color",
        "$value": "#E8F5E9"
      },
      "100": {
        "$type": "color",
        "$value": "#CDEBD5"
      },
      "200": {
        "$type": "color",
        "$value": "#A3DBBB"
      },
      "300": {
        "$type": "color",
        "$value": "#63C294"
      },
      "400": {
        "$type": "color",
        "$value": "#22A06B"
      },
      "500": {
        "$type": "color",
        "$value": "#14532D"
      },
      "600": {
        "$type": "color",
        "$value": "#0F4224"
      },
      "700": {
        "$type": "color",
        "$value": "#0C351D"
      },
      "800": {
        "$type": "color",
        "$value": "#092816"
      },
      "900": {
        "$type": "color",
        "$value": "#061C0F"
      },
      "950": {
        "$type": "color",
        "$value": "#031008"
      }
    },
    "gray": {
      "$description": "Neutral macOS-style greys. Tailwind: gray-*. Text contrast on white: 500 = 5.0:1, 600 = 7.6:1.",
      "25": {
        "$type": "color",
        "$value": "#FBFBFD"
      },
      "50": {
        "$type": "color",
        "$value": "#F5F5F7"
      },
      "100": {
        "$type": "color",
        "$value": "#EFEFF2"
      },
      "200": {
        "$type": "color",
        "$value": "#E5E5EA"
      },
      "300": {
        "$type": "color",
        "$value": "#D1D1D6"
      },
      "400": {
        "$type": "color",
        "$value": "#98989D"
      },
      "500": {
        "$type": "color",
        "$value": "#6E6E73"
      },
      "600": {
        "$type": "color",
        "$value": "#545458"
      },
      "700": {
        "$type": "color",
        "$value": "#3A3A3C"
      },
      "800": {
        "$type": "color",
        "$value": "#2C2C2E"
      },
      "900": {
        "$type": "color",
        "$value": "#1C1C1E"
      },
      "950": {
        "$type": "color",
        "$value": "#141416"
      }
    },
    "leaf": {
      "$type": "color",
      "$value": "#1B7F55",
      "$extensions": {
        "tailwind": "text-leaf",
        "usage": "Text-safe secondary green (5:1 on white); same as the storefront's leaf"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Hind Siliguri",
        "Poppins",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "SF Mono",
        "ui-monospace",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "10px",
      "$extensions": {
        "usage": "Inputs, selects (buttons are pills: rounded-full)"
      }
    },
    "card": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "usage": "Cards, floating sidebar"
      }
    },
    "window": {
      "$type": "dimension",
      "$value": "22px",
      "$extensions": {
        "usage": "Dialogs"
      }
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": "0 0 0 0.5px rgb(0 0 0 / 0.04), 0 1px 3px 0 rgb(0 0 0 / 0.05)"
    },
    "window": {
      "$type": "shadow",
      "$value": "0 0 0 0.5px rgb(0 0 0 / 0.08), 0 10px 30px -8px rgb(0 0 0 / 0.2), 0 30px 60px -20px rgb(0 0 0 / 0.25)"
    }
  },
  "material": {
    "$description": "Solid app chrome (matches the storefront header). Utilities: material, material-thick.",
    "regular": {
      "$value": {
        "background": "#FFFFFF",
        "backgroundDark": "#1E1E20"
      }
    },
    "thick": {
      "$value": {
        "background": "#FFFFFF",
        "backgroundDark": "#242426"
      }
    }
  },
  "motion": {
    "ease-mac": {
      "$type": "cubicBezier",
      "$value": [
        0.32,
        0.72,
        0,
        1
      ]
    }
  }
}
